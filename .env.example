# Twingate service key (full JSON content)
# Get this from Twingate Admin Console > Services > your service account > Generate Key
TWINGATE_SERVICE_KEY=

# The Twingate resource address (hostname:port of the private resource)
TUNNEL_DEST=your-rds-instance.region.rds.amazonaws.com:5432

# Local port for the tunnel (matches the remote service port)
TUNNEL_LOCAL_PORT=5432

# DB credentials (for the psql smoke-test container)
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=postgres
